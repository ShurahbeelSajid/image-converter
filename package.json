{
  "name": "image-forge",
  "version": "1.0.0",
  "description": "Fast image converter and compressor: any-direction JPG/PNG/WebP/AVIF/GIF/TIFF conversion, target-size compression, and images-to-PDF / PDF-to-images, with a browser worker-pool frontend, a sharp-powered server API, and batch CLIs.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "image-forge": "./cli/index.js",
    "image-forge-pdf": "./cli/pdf.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "launch": "node scripts/launch.js",
    "dev": "node --watch server/index.js",
    "convert": "node cli/index.js",
    "pdf": "node cli/pdf.js",
    "doctor": "node scripts/doctor.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:watch": "node --test --watch \"tests/*.test.js\"",
    "test:browser": "node tests/browser/run.js"
  },
  "keywords": [
    "image",
    "converter",
    "compressor",
    "webp",
    "avif",
    "jpeg",
    "png",
    "pdf",
    "sharp",
    "optimization"
  ],
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.34.2"
  }
}
